# The configuration every test run reads: a pytest session, and the e2e stack
# `icbops testing start` runs. `get_settings()` loads it whenever the
# environment is `testing`, in place of a checkout's .env.
#
# Every value here was made for the tests and is used nowhere else, so none is
# a secret. The process environment overrides any of them: a run that provides
# its own Postgres and Redis says where with TEST_DATABASE_URL and
# TEST_REDIS_URL, which pytest reads instead of the hosts below.

ENVIRONMENT="testing"
PROTOCOL="http"
APP_ID="bea144d7e5a717931a4f18e5158ba099"
AUTH_INTERNAL_SERVICE_KEY="12acb4bf02f858049dcaf0724ae30b9f5b1f18b2ee42198bd40d171aa84bed7e"

# The test stack's own services, by their compose names. pytest points the
# session at the servers it starts or is given, whatever these say.
FASTAPI_HOST="api"
FASTAPI_PORT="8000"
POSTGRES_HOST="postgres"
POSTGRES_PORT="5432"
POSTGRES_USERNAME="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="ichrisbirch"
# Empty to match the test stack's Redis, which starts with no password.
REDIS_HOST="redis"
REDIS_PORT="6379"
REDIS_PASSWORD=""
REDIS_DB="0"

# The test Traefik middleware signs every e2e request in as admin@icb.com, so
# the admin the stack seeds carries that address.
USERS_DEFAULT_ADMIN_USER_NAME="admin"
USERS_DEFAULT_ADMIN_USER_EMAIL="admin@icb.com"
USERS_DEFAULT_ADMIN_USER_PASSWORD="_eINqtzunJQx4C4IFP9VEfDW"
USERS_DEFAULT_REGULAR_USER_NAME="user"
USERS_DEFAULT_REGULAR_USER_EMAIL="user@icb.com"
USERS_DEFAULT_REGULAR_USER_PASSWORD="iZ4AksyzjJajL1-2LoCVqYBo"
