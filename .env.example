# iChrisBirch Development Environment Configuration
# Copy this file to .env and fill in your values
# IMPORTANT: Never commit .env to version control

ENVIRONMENT="development"
PROTOCOL="http"

# ============ AI Configuration ============
# Both default if unset — the model to claude-haiku-4-5, the key to empty,
# which fails at the first request rather than at startup.
AI_ANTHROPIC_API_KEY="your-anthropic-api-key"
AI_ANTHROPIC_DEFAULT_MODEL="claude-sonnet-4-6"

# ============ Authentication ============
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
AUTH_JWT_SECRET_KEY="generate-a-random-hex-string"
AUTH_JWT_SIGNING_ALGORITHM="HS256"
AUTH_INTERNAL_SERVICE_KEY="internal_service_key"
AUTH_ACCEPTING_NEW_SIGNUPS="True"

# ============ OIDC (icb CLI access tokens) ============
# All three have defaults; set them only to point at another issuer or user.
OIDC_ISSUER="https://auth.ichrisbirch.com"
OIDC_CLI_CLIENT_ID_PREFIX="icb-cli-"
# Defaults to USERS_DEFAULT_ADMIN_USER_EMAIL
OIDC_CLI_USER_EMAIL=""

# ============ FastAPI Configuration ============
FASTAPI_DEBUG="True"
FASTAPI_ENV="development"
FASTAPI_HOST="api"
FASTAPI_PORT="8000"
FASTAPI_TESTING="False"

# ============ Application ============
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
APP_ID="generate-a-random-hex-string"

# ============ GitHub ============
GITHUB_API_TOKEN="your-github-pat"

# ============ PostgreSQL ============
POSTGRES_DB="ichrisbirch"
POSTGRES_HOST="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_PORT="5432"
POSTGRES_USERNAME="postgres"
POSTGRES_DB_SCHEMAS="admin,apartments,box_packing,chat,coffee,habits"

# ============ Redis ============
REDIS_HOST="redis"
REDIS_PASSWORD=""
REDIS_PORT="6379"
REDIS_DB="0"

# ============ Default Users (for testing) ============
USERS_DEFAULT_ADMIN_USER_EMAIL="admin@example.com"
USERS_DEFAULT_ADMIN_USER_NAME="admin"
USERS_DEFAULT_ADMIN_USER_PASSWORD="adminpassword"

USERS_DEFAULT_REGULAR_USER_EMAIL="user@example.com"
USERS_DEFAULT_REGULAR_USER_NAME="user"
USERS_DEFAULT_REGULAR_USER_PASSWORD="password"

# ============ Traefik Configuration ============
# Generate with: ./deploy-containers/traefik/scripts/setup-dev-environment.sh credentials
# Format: username:$$apr1$$hash (double $ for docker-compose)
TRAEFIK_DASHBOARD_AUTH="dev:$$apr1$$generated-hash"

# Production only (used by Let's Encrypt)
# DOMAIN="yourdomain.com"
# ACME_EMAIL="admin@yourdomain.com"
